.Rproj.user
.Rhistory
.RData
inst/doc
/doc/
/Meta/
docs

# Keep only specific markdown files in the root: CLAUDE.md, NEWS.md, README.md
/*.md
!/CLAUDE.md
!/NEWS.md
!/README.md

# Generated output files
*.tar.gz
Rplots.pdf
/vignettes/*.html
!/vignettes/albers-header.html

# Package check artifacts
fmrireg.Rcheck/
*.Rcheck/
..Rcheck/

# Coverage artifacts
coverage/
*.gcov
*.gcda
*.gcno

# OMC state (oh-my-claudecode)
.omc/

# Local agent, tracker, and documentation-backup state
.albersdown.bak/
.claude/
.mote/local/
.mote/tmp/

# OS and editor files
.DS_Store
*.code-workspace
.vscode/

# Compiled object files and shared libraries
src/*.o
src/*.so
src/*.dll

# R CMD check result cache
.rcmdcheck_result.rds

# Benchmark outputs
bench/*.csv
bench/*.out

# testthat failure artifacts (check reporter)
tests/testthat/_problems/
tests/testthat/testthat-problems.rds
