diff --git a/R/h5_utils.R b/R/h5_utils.R
index 4d25d0c..4dc8da4 100644
--- a/R/h5_utils.R
+++ b/R/h5_utils.R
@@ -365,7 +365,10 @@ h5_read_subset <- function(h5, path, index = NULL, warn_memory = TRUE) {
 
 # Recursively create missing groups, preserving the leading "/"
 ensure_h5_groups <- function(h5, group_path) {
-  if (group_path == "/" || h5$exists(group_path)) {
+  # Do not ask HDF5 whether the full path exists up front: H5Lexists() errors
+  # when an intermediate group is missing (e.g. "/a/b" before "/a" exists).
+  # Walk the path one level at a time instead.
+  if (group_path == "/") {
     return(invisible(TRUE))
   }
 
@@ -373,7 +376,7 @@ ensure_h5_groups <- function(h5, group_path) {
   cur <- "" # we build "/a", "/a/b", ...
   for (p in parts) {
     cur <- paste0(cur, "/", p)
-    if (!h5$exists(cur)) h5$create_group(cur)
+    if (!h5$exists(cur)) h5$create_group(cur)$close()
   }
   invisible(TRUE)
 }
@@ -394,7 +397,8 @@ h5_write <- function(h5, path, data,
                      overwrite = FALSE,
                      create_parent = TRUE,
                      write_args = list(),
-                     verbose = getOption("h5.write.verbose", FALSE)) {
+                     verbose = getOption("h5.write.verbose", FALSE),
+                     close = TRUE) {
   # -- 1. Validate --------------------------------------------------------
   if (!inherits(h5, "H5File")) {
     stop(sprintf("h5_write: 'h5' must be an H5File object, got class: %s", paste(class(h5), collapse = ", ")))
@@ -457,7 +461,14 @@ h5_write <- function(h5, path, data,
   }
 
   if (verbose) message("h5_write: wrote ", path)
-  invisible(dset) # leave open; caller may close
+  if (isTRUE(close)) {
+    # Close the dataset handle now: an open handle keeps the file open until
+    # R's garbage collector finalises it (hdf5r's close_all() runs gc() for
+    # exactly this reason).
+    dset$close()
+    return(invisible(TRUE))
+  }
+  invisible(dset) # caller closes
 }
 
 # Internal helper to guess the HDF5 type from an R vector
