diff --git a/tests/testthat/test-h5-handles-closed.R b/tests/testthat/test-h5-handles-closed.R
new file mode 100644
index 0000000..e192c0f
--- /dev/null
+++ b/tests/testthat/test-h5-handles-closed.R
@@ -0,0 +1,35 @@
+# Writers must close every HDF5 object they create. hdf5r's H5File$close_all()
+# starts with a full gc() to finalise forgotten handles; when nothing but the
+# file itself is open, callers can close the file directly and skip that cost.
+
+test_that("write_labeled_vec leaves only the file handle open", {
+  skip_if_not_installed("neuroim2")
+  sp <- neuroim2::NeuroSpace(c(6, 6, 4))
+  mask <- neuroim2::LogicalNeuroVol(array(TRUE, c(6, 6, 4)), sp)
+  vec <- neuroim2::NeuroVec(array(rnorm(6 * 6 * 4 * 3), c(6, 6, 4, 3)),
+                            neuroim2::add_dim(sp, 3))
+  f <- tempfile(fileext = ".h5")
+  on.exit(unlink(f), add = TRUE)
+  h <- write_labeled_vec(vec, mask, c("a", "b", "c"), file = f)
+  ids <- h$get_obj_ids()
+  expect_identical(length(ids), 1L)
+  expect_identical(ids, h$id)
+  h$close()
+  back <- read_labeled_vec(f)
+  expect_equal(as.numeric(back[["b"]][mask]), as.numeric(vec[[2]][mask]),
+               tolerance = 1e-6)
+  try(close(back), silent = TRUE)
+})
+
+test_that("h5_write creates missing nested groups and closes what it creates", {
+  f <- tempfile(fileext = ".h5")
+  on.exit(unlink(f), add = TRUE)
+  h5 <- hdf5r::H5File$new(f, mode = "w")
+  fmristore:::h5_write(h5, "/a/b/x", 1:5)
+  expect_identical(length(h5$get_obj_ids()), 1L)
+  d <- fmristore:::h5_write(h5, "/a/y", 1:3, close = FALSE)
+  expect_true(d$is_valid)
+  d$close()
+  expect_identical(length(h5$get_obj_ids()), 1L)
+  h5$close()
+})
